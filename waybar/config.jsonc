// install fonts using `sudo pacman -S ttf-jetbrains-mono-nerd`
{
  "layer": "top",
  "height": 30,
  "margin-top": 6,
  "margin-left": 10,
  "margin-right": 10,
  "reload_style_on_change": true,

  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": [
    "hyprland/submap",
    "group/volume",
    "battery",
    "bluetooth",
    "network",
    "cpu",
    "memory"
  ],

  "hyprland/window": {
    "max-length": 50
  },

  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "",
      "default": ""
    }
  },

  "battery": {
    "interval": 60,
    "format": "{capacity}% {icon}",
    "format-icons": {
      "default": [
        "󰂎", "󰁺", "󰁻", "󰁼", "󰁽",
        "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"
      ],
      "charging": [
        "󰢟", "󰢜", "󰂆", "󰂇", "󰂈",
        "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"
      ]
    }
  },

// bluetooth cmd's  
// bluetoothctl scan on
// bluetoothctl connect {MAC ADDRESS} 
  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "", // an empty format will hide the module
    "format-connected": "󰂱 {device_alias}",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "on-click": "kitty --title=bluetooth-scan -e bash -c 'bluetoothctl power on; bluetoothctl --timeout 15 scan on; bluetoothctl devices; exec bluetoothctl'"
  },

  "cpu": {
    "interval": 10,
    "format": "󰻠 {}%",
    "max-length": 10,
    "on-click": "kitty --title=btop -e top"
  },

  "memory": {
    "interval": 30,
    "format": "󰘚 {percentage}%",
    "tooltip-format": "{used:0.1f}G/{total:0.1f}G used",
    "on-click": "ghostty --title=htop -e htop"
  },

// CMD'S for wifi
// nmcli device wifi list
// nmcli device wifi connect "SSID" password "PASSWORD"
  "network": {
      "format-wifi": " {essid}",
      "format-disconnected": "󰤭",
      "tooltip-format": "{ifname}\n{essid}\n{signalStrength}%",
      "on-click": "bash -c 'state=$(nmcli -t -f DEVICE,STATE device status | grep \"^wlan0:\" | cut -d: -f2); if [ \"$state\" = \"connected\" ]; then nmcli device disconnect wlan0; else nmcli device connect wlan0; fi'"
  },

    
  "clock": {
    "format": "󰥔 {:%a, %d. %b %I:%M %p}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "format": {
        "today": "<span color='#75f1fa'><b>{}</b></span>"
      }
    },
    "on-click": "chromium --app=https://calendar.google.com"
  },

  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-muted": "󰝟",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "scroll-step": 1,
    "ignored-sinks": ["Easy Effects Sink"],
    "on-click": "pavucontrol"
  },

  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal"
  },

  "group/volume": {
    "orientation": "horizontal",
    "modules": ["pulseaudio", "pulseaudio/slider"]
  }
}
